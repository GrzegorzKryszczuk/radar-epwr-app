<?xml version="1.0" encoding="utf-8"?>
<!-- Tylko HTTPS: aplikacja nie wysyła ani nie odbiera niczego zwykłym HTTP. Ufamy wyłącznie systemowym urzędom certyfikacji. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
